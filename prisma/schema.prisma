// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        Int             @id @default(autoincrement())
  nome      String
  login     String          @unique
  senhaHash String          @map("senha")
  sessoes   SessaoUsuario[]

  @@map("usuarios")
}

model Colaborador {
  id         Int      @id @default(autoincrement())
  nome       String
  cpfCifrado String   @map("cpf")
  email      String   @unique
  tarefas    Tarefa[]

  @@map("colaboradores")
}

model Tarefa {
  id             Int           @id @default(autoincrement())
  titulo         String
  descricao      String
  status         String
  id_colaborador Int
  colaborador    Colaborador   @relation(fields: [id_colaborador], references: [id])
  agendamentos   Agendamento[]

  @@map("tarefas")
}

model Agendamento {
  id           Int      @id @default(autoincrement())
  id_tarefa    Int
  data_entrega DateTime
  tarefa       Tarefa   @relation(fields: [id_tarefa], references: [id])

  @@map("agendamentos")
}

model SessaoUsuario {
  id             Int      @id @default(autoincrement())
  tokenHash      String   @unique @map("token_hash")
  usuarioId      Int      @map("usuario_id")
  loginAt        DateTime @default(now()) @map("login_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes_usuarios")
}
